            }
          }
        ],
        "responses": {
          "200": {
            "description": "Excel file downloaded or empty JSON if no data"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Export failed"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
