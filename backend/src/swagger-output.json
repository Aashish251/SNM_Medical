        "responses": {
          "200": {
            "description": "Master reports retrieved successfully"
          },
          "500": {
            "description": "Master reports failed"
          }
        }
      }
    },
    "/export": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Export search results to Excel",
        "description": "Export master search results as an Excel (.xlsx) file download.",
