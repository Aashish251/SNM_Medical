{
  "swagger": "2.0",
  "info": {
    "title": "SNM Medical API",
    "description": "API documentation for SNM Medical application",
    "version": "1.0.0",
    "contact": {
      "name": "SNM Medical Team",
      "email": "support@snmmedical.com"
    }
  },
  "host": "localhost:5000",
  "basePath": "/api",
  "tags": [
    {
      "name": "Authentication",
      "description": "User authentication operations"
    },
    {
      "name": "Registration",
      "description": "User registration and related operations"
    },
    {
      "name": "Dashboard",
      "description": "Dashboard related operations"
    },
    {
      "name": "User Management",
      "description": "User profile and role management"
    },
    {
      "name": "Search",
      "description": "Search and export functionality"
    },
    {
      "name": "DutyChart",
      "description": "Medical staff duty chart operations"
    },
    {
      "name": "Reports",
      "description": "Report generation and management"
    },
    {
      "name": "Admin - Maintenance",
      "description": "Admin maintenance operations"
    }
  ],
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter your bearer token in the format \"Bearer {token}\""
    }
  },
  "consumes": [
    "application/json",
    "multipart/form-data"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/dropdown-data": {
      "get": {
        "tags": [
          "Registration"
        ],
        "summary": "Get dropdown master data",
        "description": "Retrieve all dropdown master data (states, departments, qualifications) used in registration forms.",
        "responses": {
          "200": {
            "description": "Successfully fetched dropdown data"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/cities/{stateId}": {
      "get": {
        "tags": [
          "Registration"
        ],
        "summary": "Get cities by state",
        "description": "Get list of cities for a given state ID.",
        "parameters": [
          {
            "name": "stateId",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID of the state to get cities for",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Cities retrieved successfully"
          },
          "400": {
            "description": "Invalid state ID"
          },
          "404": {
            "description": "State not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/check-email": {
      "post": {
        "tags": [
          "Registration"
        ],
        "summary": "Check email availability",
        "description": "Check if an email address is already registered in the system.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "john.doe@example.com"
                }
              },
              "required": [
                "email"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email check completed"
          },
          "400": {
            "description": "Invalid email format"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/register": {
      "post": {
        "tags": [
          "Registration"
        ],
        "summary": "Register new user",
        "description": "Create a new user account with profile details. Supports file uploads for profile picture and certificate.",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "content-type",
            "in": "header",
            "type": "string"
          },
          {
            "name": "firstName",
            "in": "formData",
            "type": "string",
            "required": true,
            "description": "First name",
            "example": "John"
          },
          {
            "name": "lastName",
            "in": "formData",
            "type": "string",
            "required": true,
            "description": "Last name",
            "example": "Doe"
          },
          {
            "name": "email",
            "in": "formData",
            "type": "string",
            "required": true,
            "description": "Email address",
            "example": "john.doe@example.com"
          },
          {
            "name": "password",
            "in": "formData",
            "type": "string",
            "required": true,
            "description": "Password (min 8 chars)",
            "example": "Password123!"
          },
          {
            "name": "mobileNumber",
            "in": "formData",
            "type": "string",
            "required": true,
            "description": "10-digit mobile number",
            "example": "9876543210"
          },
          {
            "name": "role",
            "in": "formData",
            "type": "string",
            "required": true,
            "enum": [
              "user",
              "admin",
              "medical_staff"
            ],
            "description": "User role",
            "example": "medical_staff"
          },
          {
            "name": "gender",
            "in": "formData",
            "type": "string",
            "enum": [
              "Male",
              "Female",
              "Other"
            ],
            "description": "Gender"
          },
          {
            "name": "dateOfBirth",
            "in": "formData",
            "type": "string",
            "description": "Date of birth (YYYY-MM-DD)"
          },
          {
            "name": "stateId",
            "in": "formData",
            "type": "integer",
            "description": "State ID"
          },
          {
            "name": "cityId",
            "in": "formData",
            "type": "integer",
            "description": "City ID"
          },
          {
            "name": "address",
            "in": "formData",
            "type": "string",
            "description": "Address (max 200 chars)"
          },
          {
            "name": "pincode",
            "in": "formData",
            "type": "string",
            "description": "6-digit pincode"
          },
          {
            "name": "specialization",
            "in": "formData",
            "type": "string",
            "description": "Medical specialization"
          },
          {
            "name": "experience",
            "in": "formData",
            "type": "integer",
            "description": "Years of experience"
          },
          {
            "name": "profilePic",
            "in": "formData",
            "type": "file",
            "description": "Profile picture"
          },
          {
            "name": "certificate",
            "in": "formData",
            "type": "file",
            "description": "Certificate document"
          }
        ],
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "Invalid input data"
          },
          "409": {
            "description": "Email already exists"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/upload-profile": {
      "post": {
        "tags": [
          "Registration"
        ],
        "summary": "Upload profile image",
        "description": "Upload a profile image separately. Returns the file path.",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "profileImage",
            "in": "formData",
            "type": "file",
            "required": true,
            "description": "Profile image file"
          }
        ],
        "responses": {
          "200": {
            "description": "Profile image uploaded successfully"
          },
          "400": {
            "description": "No profile image uploaded"
          }
        }
      }
    },
    "/upload-certificate": {
      "post": {
        "tags": [
          "Registration"
        ],
        "summary": "Upload certificate document",
        "description": "Upload a certificate document separately. Returns the file path.",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "certificate",
            "in": "formData",
            "type": "file",
            "required": true,
            "description": "Certificate file"
          }
        ],
        "responses": {
          "200": {
            "description": "Certificate uploaded successfully"
          },
          "400": {
            "description": "No certificate uploaded"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login user",
        "description": "Authenticate user with email, password, and role. Returns a JWT token on success.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "400": {
            "description": "Invalid request - missing required fields"
          },
          "401": {
            "description": "Unauthorized - invalid credentials"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/forgot-password-validate": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Validate forgot password request",
        "description": "Validate user identity before allowing password reset. Verifies email, mobile number, and date of birth.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ForgotPasswordRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation successful - user identity confirmed"
          },
          "400": {
            "description": "Validation failed - user not found or details mismatch"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/reset-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Reset user password",
        "description": "Reset the password for a verified user using their registration ID.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ResetPasswordRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Password reset successful"
          },
          "400": {
            "description": "Invalid request - missing regId or newPassword"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Get dashboard statistics",
        "description": "Retrieve dashboard statistics for the authenticated user.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Statistics retrieved successfully"
          },
          "401": {
            "description": "Unauthorized - no token or invalid token"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/profile": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Get user profile",
        "description": "Retrieve the profile of the currently authenticated user.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Profile retrieved successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Update user profile",
        "description": "Update the profile of the currently authenticated user.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "firstName": {
                  "type": "string",
                  "example": "John"
                },
                "lastName": {
                  "type": "string",
                  "example": "Doe"
                },
                "mobileNumber": {
                  "type": "string",
                  "example": "9876543210"
                },
                "address": {
                  "type": "string",
                  "example": "123 Main Street"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/summary": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Get admin summary (Admin only)",
        "description": "Retrieve admin dashboard summary with aggregated stats. Requires admin role.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Admin summary retrieved successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - admin role required"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/update-role": {
      "put": {
        "tags": [
          "User Management"
        ],
        "summary": "Update user role (Admin only)",
        "description": "Update a user\\'s role and permissions. Admin access required.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateRoleRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Role updated successfully"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/update-profile/{regId}": {
      "get": {
        "tags": [
          "User Management"
        ],
        "summary": "Get user profile by registration ID",
        "description": "Retrieve a user\\'s full profile by their registration ID.",
        "parameters": [
          {
            "name": "regId",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Registration ID of the user",
            "example": 1
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "User profile retrieved successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "User Management"
        ],
        "summary": "Update user profile by registration ID",
        "description": "Update a user\\'s profile with optional file uploads (profile picture and certificate).",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "regId",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Registration ID of the user",
            "example": 1
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "firstName",
            "in": "formData",
            "type": "string",
            "description": "First name"
          },
          {
            "name": "lastName",
            "in": "formData",
            "type": "string",
            "description": "Last name"
          },
          {
            "name": "mobileNumber",
            "in": "formData",
            "type": "string",
            "description": "10-digit mobile number"
          },
          {
            "name": "address",
            "in": "formData",
            "type": "string",
            "description": "Address"
          },
          {
            "name": "profilePic",
            "in": "formData",
            "type": "file",
            "description": "Profile picture"
          },
          {
            "name": "certificate",
            "in": "formData",
            "type": "file",
            "description": "Certificate document"
          }
        ],
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          },
          "400": {
            "description": "Invalid input data"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/normalize-paths": {
      "post": {
        "tags": [
          "Admin - Maintenance"
        ],
        "summary": "Normalize all file paths in database (Admin only)",
        "description": "Convert all absolute file paths in the database to relative paths.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "Authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Paths normalized successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Failed to normalize paths"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/normalize-paths/{regIds}": {
      "post": {
        "tags": [
          "Admin - Maintenance"
        ],
        "summary": "Normalize file paths for specific users (Admin only)",
        "description": "Convert absolute file paths to relative for specific users by comma-separated registration IDs.",
        "parameters": [
          {
            "name": "regIds",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Comma-separated registration IDs (e.g. 1,2,3)",
